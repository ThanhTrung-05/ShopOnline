# --- Keycloak Database ---
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=changeme

# --- Keycloak Bootstrap Admin (read directly by the Keycloak container, KC 26.x) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=changeme

# --- Keycloak Realm/Clients (used from T3+ when the backend integrates) ---
KEYCLOAK_REALM=shoponline
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8081
KEYCLOAK_BACKEND_CLIENT_ID=shoponline-backend
KEYCLOAK_USER_ADMIN_CLIENT_ID=shoponline-user-admin
KEYCLOAK_USER_ADMIN_CLIENT_SECRET=changeme

# --- Oracle ---
# Docker Compose backend uses the docker-compose service DNS name:
#   jdbc:oracle:thin:@oracledb:1521/XEPDB1
# Host-local backend runs against the host-published Oracle port:
#   jdbc:oracle:thin:@localhost:1522/XEPDB1
ORACLE_URL=jdbc:oracle:thin:@localhost:1522/XEPDB1
ORACLE_USER=changeme
ORACLE_PASSWORD=changeme

# --- Local backend services ---
REDIS_HOST=localhost
REDIS_PORT=6379
KEYCLOAK_ADMIN_BASE_URL=http://localhost:8081
KEYCLOAK_JWK_SET_URI=http://localhost:8081/realms/shoponline/protocol/openid-connect/certs
KEYCLOAK_ISSUER=http://localhost:8081/realms/shoponline
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Dev-only test users (DO NOT use in production) ---
# Passwords are NOT stored in the realm JSON. Set them after import, see keycloak/README.md
KEYCLOAK_TEST_ADMIN_PASSWORD=changeme
KEYCLOAK_TEST_CUSTOMER_PASSWORD=changeme
